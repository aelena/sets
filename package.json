{
  "name": "exercise-tracker",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "description": "Opinionated offline PWA to log gym and home training sets on an iPhone",
  "author": "aelena",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "pwa-assets-generator",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:recaps": "cross-env RECAPS=1 playwright test tests/e2e/recap.spec.js --project=iphone-webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "dexie": "^4.4.6",
    "uplot": "^1.6.32",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
